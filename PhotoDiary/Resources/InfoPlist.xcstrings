    "NSPhotoLibraryUsageDescription" : {
      "comment" : "照片权限说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Diary keeps your diary in each photo's caption. It needs to read and edit captions, and never copies or uploads your photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日記は写真の「キャプション」に書き込まれます。キャプションの読み書きのために写真へのアクセスが必要です。写真をコピーしたりアップロードしたりすることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日记写在照片的“说明”里。照片日记需要读取和修改照片说明，不会复制或上传你的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日記寫在照片的「說明」裡。照片日記需要讀取和修改照片說明，不會複製或上傳你的照片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}